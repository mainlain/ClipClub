+    fn resign(receipt: &mut RatingReceipt, key: &Keypair) {
+        let bytes = receipt_bytes(&receipt.payload).unwrap();
+        receipt.id = hex::encode(Sha256::digest(&bytes));
+        receipt.signature = STANDARD.encode(key.sign(&bytes).unwrap());
+    }
